{
  "name": "@to-do-list/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run --no-bail \"/^dev:/\"",
    "dev:server": "nodemon --quiet --watch src --watch dev --watch routes.json --watch .env --ignore dev/sample-events --ext ts,json --exec \"tsc && node --env-file=.env dev/server.ts\"",
    "dev:db": "java -Djava.library.path=.dynamodb-local/DynamoDBLocal_lib -jar .dynamodb-local/DynamoDBLocal.jar -sharedDb -dbPath .dynamodb-local/data -port 8000 -disableTelemetry",
    "typecheck": "tsc",
    "lint": "eslint .",
    "invoke": "node --env-file=.env --enable-source-maps dev/invoke.ts",
    "db:reset": "node --env-file=.env dev/reset-local-db.ts",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node26 --main-fields=module,main --sourcemap --outfile=dist/index.mjs",
    "build": "pnpm typecheck && pnpm bundle",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-sdk/client-dynamodb": "3.1165.0",
    "@aws-sdk/lib-dynamodb": "3.1165.0",
    "@to-do-list/common": "workspace:*",
    "dynamodb-toolbox": "^2.11.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "^0.28.2",
    "eslint": "catalog:",
    "express": "^5.3.0",
    "globals": "catalog:",
    "nodemon": "^3.1.14",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
