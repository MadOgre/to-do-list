# Copy this file to .env, in this folder, and fill in your own values.
# Git ignores .env. Node reads it in pnpm dev and pnpm invoke.

# The port the dev server listens on, on localhost.
PORT=3000

# Powertools Logger prints each log line as indented JSON. Local only: Lambda never reads this file.
POWERTOOLS_DEV=true

# The database that the todos routes use: local for DynamoDB Local, which pnpm dev starts on
# port 8000, or dev for the real dev table in AWS, after aws login. The dev server refuses any
# other value.
DATABASE=local

# The todos table, named in infra/modules/app/dynamodb.tf.
TODOS_TABLE=tdl-dev-todos
